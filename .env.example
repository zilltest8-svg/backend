# Copy to .env and adjust. Every one is optional — the defaults match the live
# HR API. Nothing here is a secret: the proxy holds no credentials of its own,
# it exchanges the password you type for a session it keeps in memory.

# Where the proxy listens, and how long a signed-in session survives.
PORT=8787
SESSION_TTL_HOURS=8

# Set to 1 when the proxy sits behind an HTTPS terminator, so the session
# cookie is issued with the Secure flag.
COOKIE_SECURE=0

# Upstream HR API. Override these to point at a staging instance.
PUNCH_API_BASE=https://api.hr.zilmoney.com
PUNCH_LOGIN_PATH=/api/auth/login
PUNCH_TODAY_PATH=/api/attendance/my-today
PUNCH_SYNC_PATH=/api/attendance/my-sync
PUNCH_SYNC_STATUS_PATH=/api/attendance/my-sync-status
