# Copy to .env for local development. On Vercel these go in
# Project Settings -> Environment Variables instead.
#
# IMPORTANT: only add a variable if you are giving it a value. A variable that
# exists with an empty value is NOT the same as an absent one — in a hosting
# dashboard an empty field still arrives as "". Leave anything you are not
# overriding out entirely.


# ─── Required ────────────────────────────────────────────────────────────────

# Seals the session cookie (AES-256-GCM). Sign-in fails without it.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value — .env is gitignored.
PUNCH_SECRET=


# ─── Optional ────────────────────────────────────────────────────────────────
# Commented out on purpose. Uncomment one only to override the built-in
# default, and give it a real value when you do.

# How long a signed-in session lasts. Default: 8
# SESSION_TTL_HOURS=8

# Local server port. Default: 8787. Ignored on Vercel.
# PORT=8787

# Marks the session cookie Secure. Set automatically on Vercel; only needed if
# you terminate HTTPS yourself. Default: off
# COOKIE_SECURE=1

# Upstream HR API — override only to point at a different instance, such as
# staging. The working defaults live in server/core.mjs.
# PUNCH_API_BASE=https://api.example.com
# PUNCH_LOGIN_PATH=/api/auth/login
# PUNCH_TODAY_PATH=/api/attendance/my-today
# PUNCH_SYNC_PATH=/api/attendance/my-sync
# PUNCH_SYNC_STATUS_PATH=/api/attendance/my-sync-status
